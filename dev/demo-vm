#!/usr/bin/env bash
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
public=false
while (( $# )); do
  case "$1" in
  --help|-h)
    echo "Usage: ./dev/demo-vm [--public]"
    echo "Builds current P and opens a shell in a persistent, isolated NixOS/Incus VM."
    echo "Seeds a local-only p-ai project from committed HEAD and its Git history."
    echo "--public permits public DNS/HTTP(S) and blocks host/LAN/private destinations."
    echo "Public mode also seeds notes/main with PostgreSQL, web and worker services."
    echo "--notes is a compatibility alias for --public."
    echo "P_DEMO_STATE_DIR (or P_VM_STATE_DIR) overrides the persistent disk directory."
    exit 0
    ;;
  --public) public=true ;;
  --notes) public=true ;;
  *)
    echo "Usage: ./dev/demo-vm [--public]" >&2
    exit 2
    ;;
  esac
  shift
done
if ! [[ -t 0 && -t 1 ]]; then
  echo "Run ./dev/demo-vm in an interactive terminal." >&2
  exit 2
fi
outer_host_ipv4="" outer_host_lan_ipv4=""
default_state="$repo/.cache/p-vm/demo"
if [[ $public == true ]]; then
  for dependency in ip awk; do
    if ! command -v "$dependency" >/dev/null; then
      echo "Public mode requires $dependency; use nix run path:./dev/vm -- --public to supply the launcher dependencies." >&2
      exit 1
    fi
  done
  default_state="$repo/.cache/p-vm/demo-public"
  host_addresses=$(ip -o -4 address show)
  host_routes=$(ip -o -4 route show table all scope link type unicast)
  outer_host_ipv4=$(awk '{ sub(/\/.*/, "", $4); print $4 }' <<< "$host_addresses" | sort -u)
  outer_host_lan_ipv4=$(awk '$1 != "default" { print $1 }' <<< "$host_routes" | sort -u)
  if [[ -z $outer_host_ipv4 ]]; then
    echo "Cannot establish outer VM host-address denial policy." >&2
    exit 1
  fi
fi
export P_DEMO_STATE_DIR=${P_DEMO_STATE_DIR:-${P_VM_STATE_DIR:-"$default_state"}}
mkdir -p -- "$repo/.cache/p-vm"
exec 8>"$repo/.cache/p-vm/integration.lock"
if ! flock -n 8; then
  echo "Another P lab or VM integration run is active for this checkout." >&2
  exit 1
fi
bundle_dir=$(mktemp -d -t p-lab-bundle.XXXXXXXX)
trap 'rm -rf -- "$bundle_dir"' EXIT
git -C "$repo" bundle create --quiet "$bundle_dir/repository.bundle" HEAD
runner=$(nix-build "$repo/dev/demo.nix" -A runner --arg public "$public" \
  --argstr repositoryBundle "$bundle_dir/repository.bundle" \
  --argstr outerHostIPv4Text "$outer_host_ipv4" \
  --argstr outerHostLANIPv4Text "$outer_host_lan_ipv4" --no-out-link)
rm -rf -- "$bundle_dir"
trap - EXIT
exec "$runner/bin/p-demo-vm"
