# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# Disposable development VM disk and smoke-test console logs
/.cache/p-vm/

# Local Go dependency and compilation caches
/.cache/go-modules/
/.cache/go-build/
